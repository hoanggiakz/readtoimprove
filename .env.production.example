# ==============================================================================
# ReadToImprove — Production Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL.
# Configure these variables in the Vercel Dashboard (Project Settings -> Environment Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV="production"
# The canonical production base URL (no trailing slash)
NEXT_PUBLIC_APP_URL="https://readtoimprove.com"
NEXT_PUBLIC_APP_NAME="ReadToImprove"

# ------------------------------------------------------------------------------
# 2. Database Connection (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string used by Next.js Serverless runtime (with ?pgbouncer=true)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Unpooled direct connection string used by Prisma migrations (prisma migrate deploy)
DIRECT_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Session Security
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit key: `openssl rand -base64 32`
AUTH_SECRET="REPLACE_WITH_PRODUCTION_256_BIT_RANDOM_SECRET"
AUTH_URL="https://readtoimprove.com"

# Initial Administrator Provisioning (Must differ from local development!)
ADMIN_EMAIL="admin@readtoimprove.com"
ADMIN_INITIAL_PASSWORD="REPLACE_WITH_STRONG_PRODUCTION_PASSWORD_2026!"

# Stealth Admin Route Path (Must remain secret and not publicly advertised)
ADMIN_ROUTE_PATH="/secure-console-x7"

# ------------------------------------------------------------------------------
# 4. Distributed Rate Limiting (Upstash Redis Production)
# ------------------------------------------------------------------------------
# Upstash REST API credentials from Upstash Console -> Database -> REST API
UPSTASH_REDIS_REST_URL="https://sample-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_UPSTASH_REST_TOKEN"

# ------------------------------------------------------------------------------
# 5. Scheduled Automation (Vercel Cron)
# ------------------------------------------------------------------------------
# Random secret token sent in Authorization: Bearer <CRON_SECRET> header by Vercel Cron
CRON_SECRET="REPLACE_WITH_RANDOM_CRON_SECRET_TOKEN"

# ------------------------------------------------------------------------------
# 6. Object Storage (Vercel Blob / Cloudflare R2)
# ------------------------------------------------------------------------------
# Automatically populated by Vercel when Vercel Blob store is linked
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# Optional Cloudflare R2 alternative credentials (if used)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_PUBLIC_URL=""
