# ==============================================================================
# ReadToImprove - Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env.local for local development.
# ==============================================================================

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ReadToImprove"

# Database Connection (Phase 2)
# Local Docker PostgreSQL default on port 5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/readtoimprove?schema=public"

# Authentication & Session Security (Phase 3)
# Generate a cryptographically secure 32+ character key: `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-cryptographically-secure-secret-32-chars-min"
AUTH_URL="http://localhost:3000"

# Initial Administrator Provisioning (Phase 3)
ADMIN_EMAIL="admin@readtoimprove.com"
ADMIN_INITIAL_PASSWORD="ChangeThisPasswordImmediatelyInProduction2026!"

# Stealth Admin Route Path (Must remain secret and not publicly advertised)
ADMIN_ROUTE_PATH="/secure-console-x7"

# Object Storage (Phase 4 - Cloudflare R2 / AWS S3 compatible)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_PUBLIC_URL=""
